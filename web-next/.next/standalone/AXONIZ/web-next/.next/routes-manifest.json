    {
      "page": "/benchmarks",
      "regex": "^/benchmarks(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/benchmarks(?:/)?$"
    },
    {
      "page": "/chat",
      "regex": "^/chat(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/chat(?:/)?$"
    },
    {
      "page": "/forge",
      "regex": "^/forge(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/forge(?:/)?$"
    },
    {
      "page": "/palace",
      "regex": "^/palace(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/palace(?:/)?$"
    },
    {
      "page": "/search",
      "regex": "^/search(?:/)?$",
