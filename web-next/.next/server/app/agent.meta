    "x-next-cache-tags": "_N_T_/layout,_N_T_/(auth)/layout,_N_T_/(auth)/agent/layout,_N_T_/(auth)/agent/page,_N_T_/agent"
  },
  "segmentPaths": [
    "/_tree",
