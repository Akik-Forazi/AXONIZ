# AXONIZ-ZERO + ODYSSEUS Merged Configuration
# ============================================================

# ============================================================
# LLM Configuration - llama.cpp Integration
# ============================================================

# Llama.cpp server (your local inference)
LLAMA_HOST=127.0.0.1
LLAMA_PORT=2123
LLAMA_URL=http://127.0.0.1:2123/v1

# OpenAI-compatible API (for Odysseus features)
OPENAI_API_BASE=http://127.0.0.1:2123/v1
OPENAI_API_KEY=sk-dummy-key
DEFAULT_MODEL=claude
LLM_PROVIDER=openai

# ============================================================
# Web Server Configuration
# ============================================================

# Axoniz Web Server
WEB_HOST=127.0.0.1
WEB_PORT=7000

# ============================================================
# Models & Inference
# ============================================================

# Model vault location
MODELS_DIR=C:\Users\akikf\.axoniz\models

# Embedding model (for Odysseus RAG)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_URL=http://127.0.0.1:2123/v1/embeddings

# ============================================================
# Axoniz-Specific
# ============================================================

# Agent configuration
AGENT_TYPE=agentic
ENABLE_MEMORY=true
ENABLE_AWARENESS=true

# Code graph (Axodex)
ENABLE_CODE_GRAPH=true
PROJECT_ANALYSIS=true

# Shadow/parallel execution
ENABLE_SHADOWS=true
SHADOW_WORKERS=4

# ============================================================
# Odysseus Features Integration
# ============================================================

# Chat/Research
ENABLE_RESEARCH=true
ENABLE_DEEP_RESEARCH=true

# Email (optional - requires SMTP/IMAP setup)
# SMTP_SERVER=smtp.gmail.com
# IMAP_SERVER=imap.gmail.com
# EMAIL_ACCOUNT=your@email.com

# Calendar (optional)
# CALENDAR_SERVICE=caldav
# CALENDAR_URL=https://caldav.example.com

# RAG/Vector Store (ChromaDB optional)
# CHROMADB_HOST=localhost
# CHROMADB_PORT=8000

# ============================================================
# Logging & Debug
# ============================================================

LOG_LEVEL=INFO
DEBUG=false

# ============================================================
# Performance
# ============================================================

# GPU offloading layers (33 = most of the model)
GPU_LAYERS=33

# Context window
CONTEXT_SIZE=8192

# Batch size
BATCH_SIZE=512
