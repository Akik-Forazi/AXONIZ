{
  "installCommand": "npm ci --include=dev && cd ../axodex-shared && node ../axodex-web/node_modules/typescript/lib/tsc.js",
  "rewrites": [
    {
      "source": "/((?!assets/|api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
