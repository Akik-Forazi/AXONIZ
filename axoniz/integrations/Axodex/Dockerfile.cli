ARG BUILDPLATFORM
ARG TARGETPLATFORM

# ── Builder ────────────────────────────────────────────────────────────
# Native modules (tree-sitter-*, onnxruntime-node, node-gyp builds for
# tree-sitter-proto / tree-sitter-swift) require python3 + a C/C++ toolchain.
FROM node:22-trixie-slim AS builder

WORKDIR /app

# Toolchain for node-gyp / native builds.
RUN apt-get update && apt-get install -y --no-install-recommends python3 make g++ git && rm -rf /var/lib/apt/lists/*

# Build axodex-shared first — axodex depends on it as a workspace.
COPY axodex-shared/package.json axodex-shared/package-lock.json ./axodex-shared/
RUN npm ci --prefix axodex-shared
COPY axodex-shared ./axodex-shared
RUN rm -f axodex-shared/tsconfig.tsbuildinfo
RUN npm run build --prefix axodex-shared

# Copy the full axodex package before installing — `npm ci` triggers
# `postinstall` (patches tree-sitter-swift, builds the vendored
# tree-sitter-proto) and `prepare` (compiles TypeScript via scripts/build.js),
# both of which need the source tree.
COPY axodex ./axodex
RUN npm ci --prefix axodex

# Drop dev dependencies for a smaller runtime layer.
RUN npm prune --omit=dev --prefix axodex

# ── Runtime ────────────────────────────────────────────────────────────
FROM node:22-trixie-slim AS runtime

# curl for the healthcheck; git so `axodex` can clone repos at runtime.
RUN apt-get update && apt-get install -y --no-install-recommends curl git && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Pre-create the data directory and hand it to the unprivileged `node` user
# so the bind-mounted volume is writable without root.
RUN mkdir -p /data/axodex && chown -R node:node /data

COPY --from=builder --chown=node:node /app/axodex/dist ./axodex/dist
COPY --from=builder --chown=node:node /app/axodex/node_modules ./axodex/node_modules
COPY --from=builder --chown=node:node /app/axodex/package.json ./axodex/package.json
COPY --from=builder --chown=node:node /app/axodex/vendor ./axodex/vendor

USER node

# The web UI defaults to http://localhost:4747 — keep that contract.
ENV AXODEX_HOME=/data/axodex \
    NODE_ENV=production \
    PORT=4747

EXPOSE 4747

# Bind to 0.0.0.0 so the server is reachable from the host's mapped port.
CMD ["node", "axodex/dist/cli/index.js", "serve", "--host", "0.0.0.0", "--port", "4747"]
